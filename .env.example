# Copie para .env na raiz do repositório:
#   cp .env.example .env
#
# Subir serviços:
#   docker compose -f infra/docker/docker-compose.yml --env-file .env up -d

# PostgreSQL
POSTGRES_USER=tatami
POSTGRES_PASSWORD=tatami_dev
POSTGRES_DB=tatami
# Porta 5433 evita conflito com PostgreSQL instalado no Mac (geralmente usa 5432)
POSTGRES_PORT=5433

# Connection string usada pela API (Tatami.Api)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=tatami;Username=tatami;Password=tatami_dev

# Redis (rate limiting — issue #11)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (storage — issue #12)
MINIO_ROOT_USER=tatami_minio
MINIO_ROOT_PASSWORD=tatami_minio_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_PHOTOS=tatami-photos
MINIO_BUCKET_CONTRACTS=tatami-contracts

# Bindings usados pela API (Tatami.Api)
Minio__Endpoint=http://localhost:9000
Minio__PublicEndpoint=http://localhost:9000
Minio__AccessKey=tatami_minio
Minio__SecretKey=tatami_minio_dev
Minio__BucketPhotos=tatami-photos
Minio__BucketContracts=tatami-contracts
Minio__ForcePathStyle=true

# JWT (API — use secret forte em produção, mínimo 32 caracteres)
Jwt__Secret=tatami-dev-jwt-secret-change-in-production-min-32-chars
Jwt__Issuer=tatami-api
Jwt__Audience=tatami-web
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# Mensalidades PIX (issue #21): segredo exclusivo dos crons; vazio desabilita as rotas
Cron__Secret=

# Stripe SaaS (issue #32) — use chaves de TEST MODE
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__TrialDays=5
Stripe__FrontendBaseUrl=http://localhost:4200
Stripe__PriceIds__Starter=price_1TnTDWJbC64QkQGS8OwQNBJM
Stripe__PriceIds__Pro=price_1TnTDnJbC64QkQGSlGmIdkcC
Stripe__PriceIds__MultiUnit=price_1TkFfOJFm0PQ5umUgHBYJDvM

# Encaminhar webhooks localmente:
#   stripe listen --forward-to localhost:5006/api/webhooks/stripe
# Depois cole o whsec_... em Stripe__WebhookSecret
